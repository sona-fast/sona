# Sona — Cloudflare configuration template.
#
# Copy this file to `wrangler.toml` and fill in your own values (or let the
# setup CLI generate it for you). `wrangler.toml` itself is gitignored so each
# deployment keeps its own resource IDs without merge conflicts when you pull
# upstream Sona updates.

# Your Cloudflare Pages project name (lowercase, hyphenated). Also used as the
# wrangler-action --project-name and the GitHub Actions CLOUDFLARE_PAGES_PROJECT var.
name = "sona"
compatibility_date = "2025-04-01"
compatibility_flags = ["nodejs_compat"]
pages_build_output_dir = ".svelte-kit/cloudflare"

# Fursuit-photos feature gate. 'off' disables it, 'mock' serves bundled demo
# data for local dev, 'live' calls the real FurTrack API (requires approval).
[vars]
FURTRACK_MODE = "off"

# Secrets (NOT defined here — set with `wrangler pages secret put <NAME>`; the
# `npm run setup` CLI sets SETUP_TOKEN + CRON_SECRET for you):
#   SETUP_TOKEN        — one-time bootstrap token for the first-run wizard
#                        (/admin/setup); required in production
#   UPLOADTHING_TOKEN  — only if storageProvider = 'uploadthing'
#   TELEGRAM_BOT_TOKEN — optional; enables the Telegram sticker importer
#   CRON_SECRET        — optional; bearer for POST /api/cron/* (sticker re-sync)
#   ADMIN_PASSWORD     — legacy/optional; new installs set the password in the
#                        wizard (stored hashed). If present, login accepts it once
#                        and migrates it to a hash.
#   REGISTRY_API_KEY   — optional; enables the shared artist registry (search/pull/
#                        submit/sync). Get one via POST /v1/forks on the registry.
#   REGISTRY_URL       — optional; override the registry base URL (defaults to the
#                        public registry, https://registry.sona.fast).
#   RESEND_API_KEY     — optional; enables the admin "Forgot password" reset email
#                        (via Resend). Without it, recovery is `npm run reset-password`.
#   RESEND_FROM        — optional; reset-email sender, format "Name <you@domain>".
#                        Defaults to "Sona <onboarding@resend.dev>". A custom domain
#                        must be verified in your own Resend account first.

# D1 database. Create with `wrangler d1 create <your-db-name>` and paste the
# returned database_id here.
[[d1_databases]]
binding = "DB"
database_name = "sona-db"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"

# Image object storage (R2). Only used when the active storage provider is 'r2'
# (a site setting). Public delivery is via a custom domain on the bucket, set as
# the `r2PublicUrl` site setting (e.g. https://cdn.example.com).
[[r2_buckets]]
binding = "IMAGES"
bucket_name = "sona-images"
