{
	"name": "sona",
	"private": true,
	"version": "1.1.0",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"setup": "tsx scripts/setup.ts",
		"reset-password": "tsx scripts/reset-password.ts",
		"connect-domains": "tsx scripts/connect-domains.ts",
		"apply-download-ratelimit": "tsx scripts/apply-download-ratelimit.ts",
		"predev": "tsx scripts/dev-bootstrap.ts",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --output-structure locale-modules",
		"prepare": "npm run paraglide || echo '' && svelte-kit sync || echo ''",
		"check": "npm run paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:catalog-pinning": "node scripts/check-catalog-pinning.mjs",
		"check:lockfile-security": "node scripts/check-lockfile-security.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"pretest": "npm run paraglide",
		"test": "vitest run",
		"pretest:watch": "npm run paraglide",
		"test:watch": "vitest",
		"pretest:integration": "npm run paraglide",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"pretest:e2e": "npm run paraglide",
		"test:e2e": "playwright test",
		"test:e2e:seed": "tsx tests/e2e/seed.ts"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260804.1",
		"@inlang/paraglide-js": "^2.18.1",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/cookie": "^0.6.0",
		"@types/node": "^25.9.1",
		"@types/three": "^0.185.4",
		"better-sqlite3": "^12.9.0",
		"cookie": "^0.7.2",
		"drizzle-kit": "^0.31.10",
		"esbuild": "^0.28.1",
		"miniflare": "^4.20260730.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.7"
	},
	"dependencies": {
		"@pixiv/three-vrm": "^3.5.5",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@uploadthing/shared": "^7.1.10",
		"@uploadthing/svelte": "^7.3.3",
		"drizzle-orm": "^0.45.2",
		"effect": "^3.17.7",
		"emojilib": "^4.0.3",
		"lottie-web": "^5.13.0",
		"lucide-svelte": "^0.468.0",
		"three": "^0.185.1",
		"uploadthing": "^7.7.4",
		"wrangler": "^4.124.0"
	},
	"overrides": {
		"undici": "^7.29.0",
		"cookie@<0.7.0": "^0.7.2",
		"esbuild@<0.25.0": "^0.25.0"
	}
}
